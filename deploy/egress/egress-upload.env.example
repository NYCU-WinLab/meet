NC_URL=https://nextcloud.winlab.tw
NC_USER=video-svc
NC_PASS=<nextcloud app password>
NC_DIR=meet
TX_URL=https://transcribe.winlab.tw
TX_TOKEN=<transcribe api token>
# winlab-helper's own trigger (project 165), with the Maintainer-owned
# "meet egress" token from winlab-helper#10.
GL_TRIGGER_URL=https://gitlab.winlab.tw/api/v4/projects/165/trigger/pipeline
GL_TRIGGER_TOKEN=<winlab-helper trigger token>
GL_TRIGGER_REF=main
# Same value as winlab-helper's protected HELPER_RELAY_SECRET; signs each hand-off.
HELPER_RELAY_SECRET=<shared relay secret>
