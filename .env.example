# --- Deployment (compose) ---
# Image tag: main, sha-<7>, or a release.
MEET_VERSION=main
# Where web listens on the host.
MEET_BIND=127.0.0.1
MEET_PORT=3000
POSTGRES_PASSWORD=

# --- Sign-in ---
# The public URL; also the MCP resource (<url>/mcp) and issuer base.
BETTER_AUTH_URL=https://meet.example.com
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# A confidential OIDC client in your Keycloak realm, redirect URI
# <BETTER_AUTH_URL>/api/auth/callback/keycloak.
KEYCLOAK_ISSUER=https://auth.example.com/realms/example
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# --- LiveKit ---
# The LiveKit server browsers connect to (wss://) and the API key pair that
# mints their tokens. Point the server's webhook at <BETTER_AUTH_URL>/api/livekit/webhook
# with the same key so open pages refresh when rooms change.
LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Observability (optional; off when the endpoint is empty) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
# Authorization=Bearer <token>
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=meet

# --- Portal ---
# An API key from portal.winlab.tw/api-keys: lists the project groups a
# room's recording can be filed under, and their members, who may open
# that group's recordings.
PORTAL_API_KEY=

# --- Recordings ---
# The Nextcloud account the egress uploader files recordings with (an app
# password), read-only use: /recordings lists, plays and downloads them.
NC_URL=https://nextcloud.winlab.tw
NC_USER=video-svc
NC_PASS=
NC_DIR=meet
# A read_api token for gitlab.winlab.tw: finds the meeting record
# winlab-helper filed a recording under.
GITLAB_API_TOKEN=

# --- Summary ---
# The lab's transcribe service and an app token from its /settings/tokens.
TRANSCRIBE_URL=https://transcribe.winlab.tw
TRANSCRIBE_TOKEN=
# Decode language; Whisper mistakes Mandarin for Japanese when it guesses.
SUMMARY_LANGUAGE=zh
# The model that rewrites the summary.
ANTHROPIC_API_KEY=
SUMMARY_MODEL=claude-haiku-5-5

# --- Services ---
# Keys trusted services call /api/actions/<name> with: "portal:<key>,other:<key>".
# The egress uploader is "egress": it calls recording_gaps and file_recording.
SERVICE_KEYS=
